# Airtable Configuration
# Get these values from your Airtable account:
# 1. Go to https://airtable.com/create/apikey to create a personal access token
# 2. Find your base ID in the API documentation: https://airtable.com/api
# 3. The table name should match your table in Airtable (default: "Products")

AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here
AIRTABLE_TABLE_NAME=Products

# How to set up in Netlify:
# 1. Go to your site in the Netlify dashboard
# 2. Navigate to Site settings > Environment variables
# 3. Add each variable above with your actual values
# 4. Deploy your site for the changes to take effect
